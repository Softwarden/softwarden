tools
mcp
site
# One machine's local state, which `COPY apps/api/ ./` in the Dockerfile would otherwise build into the image and hand
# to everyone who pulls it: attachment files and organization exports a local run wrote under
# media/, the first-run setup token, environment files, logs, backups, certificates and review notes. Everything
# .gitignore ignores under apps/api must be matched here too (tests/test_dockerignore.py checks).
apps/api/media
apps/api/.bootstrap
**/.env
**/.env.*
!**/.env.example
**/*.log
