  "motion": {
    "duration-fast": "120ms",
    "duration-base": "200ms",
    "ease": "cubic-bezier(.2, 0, 0, 1)"
  },
  "layout": {
    "$doc": "Density and shell sizes: data list rows are comfortable (60 px, as the queues are drawn) or compact (44 px), chosen per user; the sidebar is 232 px or a 64 px rail.",
    "row-comfortable": "60px",
    "row-compact": "44px",
    "sidebar-width": "232px",
    "rail-width": "64px"
  },
  "radius": {
    "radius": "0.5rem"
  },
  "font": {
    "sans": "\"Inter Variable\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, sans-serif",
    "display": "\"Inter Variable\", \"Segoe UI Variable Display\", \"Segoe UI\", system-ui, sans-serif",
    "mono": "ui-monospace, \"Cascadia Mono\", \"SF Mono\", Consolas, monospace",
    "features": "\"cv11\", \"ss01\", \"tnum\""
  },
  "text": {
    "$doc": "Type scale: size / line height; display sizes also take letter-spacing -0.01em",
    "body": ["14px", "1.5"],
    "title": ["24px", "32px"],
    "dialog": ["18px", "24px"],
    "section": ["15px", "20px"]
  },
