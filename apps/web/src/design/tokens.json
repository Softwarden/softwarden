      ["muted-foreground", "row-selected", 4.5], ["icon", "card", 3],
      ["link", "background", 4.5], ["link", "card", 4.5], ["link", "popover", 4.5], ["link", "table-head", 4.5], ["link", "row-hover", 4.5],
      ["link", "row-selected", 4.5], ["link", "muted", 4.5],
      ["primary-foreground", "primary", 4.5], ["primary-foreground", "primary-hover", 4.5],
      ["accent-foreground", "accent", 4.5], ["destructive-foreground", "destructive", 4.5],
