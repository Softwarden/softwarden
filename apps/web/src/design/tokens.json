      ["toast-foreground", "toast", 4.5], ["toast-action", "toast", 4.5],
      ["border-strong", "card", 3, "dark"], ["border-strong", "background", 3, "dark"],
      ["accent-line", "card", 3], ["accent-line", "accent", 3], ["accent-line", "background", 3], ["accent-line", "popover", 3],
      ["input", "card", 3], ["input", "background", 3], ["ring", "card", 3], ["ring", "background", 3],
      ["state-overdue-foreground", "state-overdue", 4.5], ["state-pending-foreground", "state-pending", 4.5],
