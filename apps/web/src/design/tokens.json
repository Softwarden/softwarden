      ["lifecycle-retired-foreground", "lifecycle-retired", 4.5],
      ["lifecycle-active-border", "card", 3], ["lifecycle-deprecated-border", "card", 3], ["lifecycle-retired-border", "card", 3],
      ["criticality-critical", "card", 4.5], ["criticality-critical", "row-hover", 4.5], ["criticality-critical", "background", 4.5],
      ["criticality-high", "card", 4.5], ["criticality-high", "row-hover", 4.5], ["criticality-high", "background", 4.5],
      ["kind-application-foreground", "kind-application", 4.5], ["kind-component-foreground", "kind-component", 4.5],
