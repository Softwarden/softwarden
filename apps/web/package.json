  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "predev": "node scripts/tokens.mjs",
    "dev": "vite",
    "prebuild": "node scripts/tokens.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "api:types": "node scripts/openapi-types.mjs",
    "api:check": "node scripts/openapi-types.mjs --check",
    "lint": "node scripts/tokens.mjs --check && node scripts/openapi-types.mjs --check && node --test scripts/check-colours.test.mjs scripts/check-spelling.test.mjs scripts/check-docs-spelling.test.mjs scripts/bundle-size.test.mjs scripts/third-party-notices.test.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/markdown.test.mjs scripts/session-gate.test.mjs && node scripts/check-colours.mjs && node scripts/check-spelling.mjs && node scripts/check-docs-spelling.mjs && eslint .",
    "size": "node scripts/bundle-size.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@scalar/api-reference-react": "0.9.96",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "cytoscape": "3.35.0",
    "lucide-react": "^1.79.0",
    "radix-ui": "^1.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "3.11.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.48.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "6.4.6"
  }
