# Copy to ops/backup.env (never commit that file) and edit. Values set in the environment win over this file.
# Lines are plain shell assignments.

# Required: where backups go. A mounted share or any folder your organization provides. Not inside the project directory.
BACKUP_DEST=/mnt/softwarden-backups

# Required: the encryption key file. Mode 600, outside the project directory; a copy also lives off the host.
BACKUP_KEY_FILE=/etc/softwarden/backup.key

# Optional: the Compose project directory when the script is not run from it.
#SOFTWARDEN_DIR=/opt/softwarden

# Optional: how many to keep (defaults shown).
#BACKUP_KEEP_DAILY=14
#BACKUP_KEEP_WEEKLY=8
