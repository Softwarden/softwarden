---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../site.config';

interface Props {
  current?: 'docs' | 'changelog' | 'home';
}
const { current } = Astro.props;

const links = [
  { href: '/#features', label: 'Features' },
  { href: '/docs/', label: 'Docs', key: 'docs' },
  { href: '/#editions', label: 'Editions' },
  { href: '/changelog/', label: 'Changelog', key: 'changelog' },
  ...(siteConfig.githubPublic ? [{ href: siteConfig.repo, label: 'GitHub' }] : []),
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Softwarden home">
      <Logo size={26} />
      <span>softwarden</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.key && l.key === current ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <div class="desktop-only"><ThemeToggle id="theme-desktop" /></div>
      <a class="btn btn-sm" href="/docs/install/">Install</a>
      <details class="menu">
        <summary>
          <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="visually-hidden">Menu</span>
        </summary>
        <div class="menu-panel">
          <nav aria-label="Main, small screens">
            <ul>
              {
                links.map((l) => (
                  <li>
                    <a href={l.href} aria-current={l.key && l.key === current ? 'page' : undefined}>
                      {l.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="menu-theme">
            <span class="muted small">Theme</span>
            <ThemeToggle id="theme-mobile" />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the small-screen menu after choosing a link (same-page anchors don't reload) and on Escape.
  const menu = document.querySelector<HTMLDetailsElement>('.site-header details.menu');
  if (menu) {
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--background);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-strong);
    text-decoration: none;
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.035em;
    margin-right: auto;
  }
  .nav-desktop ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-desktop a,
  .menu-panel a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 6px 12px;
    border-radius: var(--radius-md);
    color: var(--foreground);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
  }
  .nav-desktop a:hover,
  .menu-panel a:hover {
    background: var(--row-hover);
  }
  .nav-desktop a[aria-current='page'],
  .menu-panel a[aria-current='page'] {
    color: var(--accent-foreground);
    background: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--card);
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu-icon {
    display: grid;
    gap: 4px;
  }
  .menu-icon span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--foreground);
    border-radius: 1px;
  }
  .menu[open] .menu-icon span:nth-child(2) {
    opacity: 0;
  }
  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    width: min(280px, calc(100vw - 32px));
    background: var(--popover);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 8px;
  }
  .menu-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .menu-panel a {
    width: 100%;
  }
  .menu-theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px 4px;
    margin-top: 6px;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 860px) {
    .nav-desktop,
    .desktop-only {
      display: none;
    }
    .menu {
      display: block;
    }
  }
</style>
